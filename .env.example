# The Flask course API. For local development, use http://localhost:5000.
REACT_APP_API_SERVER_IP=http://localhost:5000

# Optional hosted features. Leave unset to run the public course planner.
# REACT_APP_BACKEND_SERVER_IP=https://your-service.example
# REACT_APP_COGNITO_AUTHORITY=https://your-user-pool.example
# REACT_APP_COGNITO_CLIENT_ID=your-public-app-client-id
# REACT_APP_COGNITO_REDIRECT_URI=https://your-site.example/callback
# REACT_APP_COGNITO_DOMAIN=https://your-hosted-login.example
# REACT_APP_COGNITO_LOGOUT_URI=https://your-site.example
# REACT_APP_MAPBOX_ACCESS_TOKEN=your-public-mapbox-token
# REACT_APP_GA_TOKEN=your-analytics-measurement-id
